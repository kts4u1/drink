# 선택: 내 PC 에서 유료 Claude 로 사진 분석을 시험할 때만 (npm start). 이 파일을 .env 로 복사하고 값을 넣으세요.
# 비워 두면 사진은 브라우저 안에서 무료로 분석해요(글자·바코드 인식). 무료 AI(Workers AI)는 Cloudflare 에서만 돌아요.
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않아요. 키를 코드나 채팅에 붙여 넣지 마세요.

# Anthropic API 키 (https://platform.claude.com 에서 발급, 유료)
ANTHROPIC_API_KEY=

# 쓸 모델 (비우면 claude-opus-5-5). 비용을 줄이려면 claude-sonnet-5-5
CLAUDE_MODEL=

# 하루 최대 AI 호출 수 (0 이면 제한 없음)
DAILY_LIMIT=0

# 서버 포트 (기본 3000)
PORT=3000
