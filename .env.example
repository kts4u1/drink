# 내 PC 에서 사진으로 술 알아보기를 시험할 때 (npm start). 이 파일을 .env 로 복사하고 값을 넣으세요.
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않아요. 키를 코드나 채팅에 붙여 넣지 마세요.

# Anthropic API 키 (https://platform.claude.com 에서 발급)
ANTHROPIC_API_KEY=

# 쓸 모델 (비우면 claude-opus-5-5). 비용을 줄이려면 claude-sonnet-5-5
CLAUDE_MODEL=

# 하루 최대 AI 호출 수 (0 이면 제한 없음)
DAILY_LIMIT=0

# 서버 포트 (기본 3000)
PORT=3000
