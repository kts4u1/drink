// Cloudflare Worker 설정 — 사진으로 술 알아보기 API (화면은 GitHub Pages)
// 배포: GitHub Actions 가 자동으로 실행 (npx wrangler deploy)
// 내 PC 에서 시험: .dev.vars 에 ANTHROPIC_API_KEY=... 를 넣고 npx wrangler dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sulsul-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // 이 주소의 화면만 API 를 부를 수 있어요 (쉼표로 여러 개)
    "ALLOWED_ORIGINS": "https://kts4u1.github.io",
    // 하루 최대 AI 호출 수 (같은 사진·이름을 다시 물어보는 건 저장된 결과라 세지 않음)
    "DAILY_LIMIT": "100",
    // 쓸 Claude 모델. 비용을 줄이려면 claude-sonnet-5-5 로 바꿀 수 있어요
    "CLAUDE_MODEL": "claude-opus-5-5"
  },
  // IP 마다 1분에 6번까지
  "ratelimits": [
    { "name": "IDENTIFY_LIMITER", "namespace_id": "4101", "simple": { "limit": 6, "period": 60 } }
  ],
  // 결과 캐시·하루 사용량 저장소 (Workers KV)
  // 실제 id 는 배포 때 scripts/ensure-kv.js 가 채웁니다.
  // kv-start
  "kv_namespaces": [
    { "binding": "CACHE", "id": "SULSUL_KV_ID_PLACEHOLDER" }
  ],
  // kv-end
  "observability": {
    "enabled": true
  }
}
