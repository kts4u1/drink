// Cloudflare Worker 설정 — 사진으로 술 알아보기 API (무료 Workers AI, 화면은 GitHub Pages)
// 배포: GitHub Actions 가 자동으로 실행 (npx wrangler deploy)
// 내 PC 에서 시험: npx wrangler dev --remote (Workers AI 는 Cloudflare 에서 실행돼요)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sulsul-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // 이 주소의 화면만 API 를 부를 수 있어요 (쉼표로 여러 개)
    "ALLOWED_ORIGINS": "https://kts4u1.github.io",
    // 사진 분석 AI: workers-ai = Cloudflare 무료 하루 할당량 (기본, 돈이 들지 않음)
    //               anthropic  = 유료 Claude (ANTHROPIC_API_KEY 시크릿 필요)
    "AI_PROVIDER": "workers-ai",
    // Workers AI 의 사진을 읽는 모델
    "WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    // 하루 최대 AI 호출 수. 무료 할당량(하루 10,000 뉴런) 안에 들도록 낮게 잡았어요.
    // 같은 사진·이름을 다시 물어보는 건 저장된 결과라 세지 않고, 넘으면 화면이 기기 안 분석으로 바꿔요.
    "DAILY_LIMIT": "50",
    // AI_PROVIDER 가 anthropic 일 때 쓸 Claude 모델
    "CLAUDE_MODEL": "claude-opus-5-5",
    // 세계 술 데이터 (X-Wines 와인 10만 · 위키데이터 생산자) — 화면과 같은 GitHub Pages 파일을 필요한 조각만 받아 씀
    "WORLD_URL": "https://kts4u1.github.io/drink/data/world"
  },
  // Cloudflare Workers AI
  "ai": { "binding": "AI" },
  // IP 마다 1분에 6번까지
  "ratelimits": [
    { "name": "IDENTIFY_LIMITER", "namespace_id": "4101", "simple": { "limit": 6, "period": 60 } }
  ],
  // 결과 캐시·하루 사용량 저장소 (Workers KV)
  // 실제 id 는 배포 때 scripts/ensure-kv.js 가 채웁니다.
  // kv-start
  "kv_namespaces": [
    { "binding": "CACHE", "id": "SULSUL_KV_ID_PLACEHOLDER" }
  ],
  // kv-end
  "observability": {
    "enabled": true
  }
}
